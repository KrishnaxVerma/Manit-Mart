rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User profiles and wishlists
    match /users/{userId} {
      allow read, write: if isAuthenticated();

      match /wishlist/{listingId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Products / listings: public read so all users/visitors can browse; authenticated write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Conversations and Messages: authenticated access without email verification barriers
    match /conversations/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
