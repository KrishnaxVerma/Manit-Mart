rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isParticipant(data) {
      return verified() && request.auth.uid in data.participants;
    }

    function validConversation(data) {
      return data.keys().hasOnly([
               'id', 'listingId', 'listingTitle', 'listingPrice', 'listingImage',
               'sellerId', 'buyerId', 'participants', 'lastMessage', 'lastUpdated',
               'unreadCount', 'dealPrice'
             ]) &&
             data.keys().hasAll([
               'id', 'listingId', 'listingTitle', 'listingPrice', 'listingImage',
               'sellerId', 'buyerId', 'participants', 'lastMessage', 'lastUpdated', 'unreadCount'
             ]) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 150 &&
             data.listingId is string && data.listingId.size() > 0 &&
             data.listingTitle is string && data.listingTitle.size() <= 200 &&
             data.listingPrice is number && data.listingPrice >= 0 &&
             data.listingImage is string && data.listingImage.size() <= 2000 &&
             data.sellerId is string && data.buyerId is string &&
             data.sellerId != data.buyerId &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants.hasAll([data.sellerId, data.buyerId]) &&
             data.lastMessage is string && data.lastMessage.size() <= 2000 &&
             data.lastUpdated is timestamp && data.unreadCount is map &&
             (!('dealPrice' in data) || (data.dealPrice is number && data.dealPrice > 0));
    }

    function validMessage(data) {
      return data.keys().hasOnly([
               'senderId', 'text', 'createdAt', 'isOffer', 'offerAmount', 'status', 'acceptedAt'
             ]) &&
             data.keys().hasAll(['senderId', 'text', 'createdAt', 'isOffer']) &&
             data.senderId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
             data.createdAt is timestamp && data.isOffer is bool &&
             (data.isOffer == false || (data.offerAmount is number && data.offerAmount > 0)) &&
             (!('status' in data) || (data.isOffer == true && data.status == 'ACCEPTED')) &&
             (!('acceptedAt' in data) || (data.isOffer == true && data.acceptedAt is timestamp));
    }

    function validProduct(data) {
      return data.keys().hasOnly([
               'title', 'category', 'price', 'condition', 'description', 'imageUrls',
               'sellerId', 'sellerName', 'sellerEmail', 'updatedAt', 'createdAt', 'interested',
               'status', 'buyerId', 'handshakeOtp', 'dealPrice', 'reservedAt', 'otpExpiresAt', 'completedAt'
             ]) &&
             data.keys().hasAll([
               'title', 'category', 'price', 'condition', 'description', 'imageUrls',
               'sellerId', 'sellerName', 'sellerEmail', 'updatedAt', 'createdAt', 'status'
             ]) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             data.price is number && data.price > 0 &&
             data.condition is string && data.condition.size() > 0 && data.condition.size() <= 50 &&
             data.description is string && data.description.size() <= 500 &&
             data.imageUrls is list && data.imageUrls.size() > 0 && data.imageUrls.size() <= 5 &&
             data.sellerId is string && data.sellerName is string && data.sellerEmail is string &&
             data.status in ['AVAILABLE', 'RESERVED', 'SOLD'] &&
             (data.status != 'RESERVED' || (
               data.buyerId is string && data.handshakeOtp is string &&
               data.handshakeOtp.matches('^[0-9]{4}$') && data.dealPrice is number &&
               data.reservedAt is timestamp && data.otpExpiresAt is timestamp
             ));
    }

    function reservationExpired(data) {
      return ('otpExpiresAt' in data && data.otpExpiresAt <= request.time) ||
        (!('otpExpiresAt' in data) &&
          (!('reservedAt' in data) || data.reservedAt + duration.value(5, 'm') <= request.time));
    }

    match /users/{userId} {
      allow read: if verified();
      allow create, update: if verified() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'name', 'hostel', 'role', 'email', 'createdAt', 'updatedAt', 'upiId', 'branch'
        ]) &&
        (!('upiId' in request.resource.data) || request.resource.data.upiId == '' ||
          request.resource.data.upiId.matches('^[A-Za-z0-9._-]{2,}@[A-Za-z0-9.-]{2,}$'));
      allow delete: if false;

      match /wishlist/{listingId} {
        allow read, delete: if verified() && request.auth.uid == userId;
        allow create, update: if verified() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'listingId', 'addedPrice', 'savedAt', 'title', 'price', 'images',
            'pickupLocation', 'sellerId', 'status'
          ]) && request.resource.data.listingId == listingId;
      }
    }

    match /products/{productId} {
      allow read: if verified();
      allow create: if verified() && validProduct(request.resource.data) &&
        request.resource.data.sellerId == request.auth.uid &&
        request.resource.data.status == 'AVAILABLE' &&
        !('buyerId' in request.resource.data) && !('handshakeOtp' in request.resource.data) &&
        !('dealPrice' in request.resource.data) && !('reservedAt' in request.resource.data) &&
          !('completedAt' in request.resource.data) && !('otpExpiresAt' in request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'title', 'category', 'price', 'condition', 'description', 'imageUrls',
          'sellerId', 'sellerName', 'sellerEmail', 'updatedAt', 'createdAt',
          'interested', 'status'
        ]) && request.resource.data.title is string && request.resource.data.title.size() >= 3 &&
        request.resource.data.price is number && request.resource.data.price > 0 &&
        request.resource.data.imageUrls is list && request.resource.data.imageUrls.size() > 0 &&
        request.resource.data.imageUrls.size() <= 5;
      allow update: if verified() && validProduct(request.resource.data) && (
        (resource.data.sellerId == request.auth.uid && resource.data.status == 'AVAILABLE' &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.status == 'AVAILABLE' &&
          (!('otpExpiresAt' in resource.data) || resource.data.otpExpiresAt <= request.time) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'category', 'price', 'condition', 'description', 'imageUrls', 'sellerName',
            'sellerEmail', 'updatedAt'
          ])) ||
        (resource.data.status == 'AVAILABLE' && request.resource.data.status == 'AVAILABLE' &&
          request.resource.data.buyerId == request.auth.uid &&
          request.auth.uid != resource.data.sellerId &&
          (!('otpExpiresAt' in resource.data) || resource.data.otpExpiresAt <= request.time ||
            resource.data.buyerId == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'buyerId', 'dealPrice', 'handshakeOtp', 'reservedAt', 'otpExpiresAt'
          ]) && request.resource.data.dealPrice is number && request.resource.data.dealPrice > 0 &&
          request.resource.data.handshakeOtp is string && request.resource.data.handshakeOtp.matches('^[0-9]{4}$') &&
          request.resource.data.reservedAt is timestamp && request.resource.data.otpExpiresAt is timestamp &&
          request.resource.data.otpExpiresAt > request.time &&
          request.resource.data.otpExpiresAt <= request.time + duration.value(5, 'm') + duration.value(5, 's')) ||
        (resource.data.status == 'RESERVED' && reservationExpired(resource.data) &&
          request.resource.data.status == 'AVAILABLE' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'buyerId', 'dealPrice', 'handshakeOtp', 'reservedAt', 'otpExpiresAt'
          ]) && !('buyerId' in request.resource.data) && !('dealPrice' in request.resource.data) &&
          !('handshakeOtp' in request.resource.data) && !('reservedAt' in request.resource.data) &&
          !('otpExpiresAt' in request.resource.data)) ||
        (resource.data.sellerId == request.auth.uid &&
          resource.data.status in ['AVAILABLE', 'RESERVED'] &&
          request.resource.data.status == 'SOLD' &&
          resource.data.buyerId is string && resource.data.handshakeOtp is string &&
          resource.data.otpExpiresAt is timestamp && resource.data.otpExpiresAt > request.time &&
          request.resource.data.handshakeOtp == resource.data.handshakeOtp &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']) &&
          request.resource.data.completedAt is timestamp)
      );
      allow delete: if verified() && resource.data.sellerId == request.auth.uid &&
        resource.data.status == 'AVAILABLE' &&
        (!('otpExpiresAt' in resource.data) || resource.data.otpExpiresAt <= request.time);
    }

    match /conversations/{chatId} {
      allow read: if isParticipant(resource.data);
      allow create: if verified() && validConversation(request.resource.data) &&
        request.resource.data.buyerId == request.auth.uid &&
        exists(/databases/$(database)/documents/products/$(request.resource.data.listingId)) &&
        get(/databases/$(database)/documents/products/$(request.resource.data.listingId)).data.sellerId == request.resource.data.sellerId &&
        get(/databases/$(database)/documents/products/$(request.resource.data.listingId)).data.status == 'AVAILABLE';
      allow update: if isParticipant(resource.data) && validConversation(request.resource.data) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.listingId == resource.data.listingId &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if isParticipant(resource.data) && resource.data.lastMessage == '';

      match /messages/{messageId} {
        function parentParticipant() {
          return verified() && exists(/databases/$(database)/documents/conversations/$(chatId)) &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(chatId)).data.participants;
        }
        allow read: if parentParticipant();
        allow create: if parentParticipant() && validMessage(request.resource.data);
        allow update: if parentParticipant() && resource.data.isOffer == true &&
          resource.data.senderId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']) &&
          request.resource.data.status == 'ACCEPTED' && request.resource.data.acceptedAt is timestamp;
        allow delete: if false;
      }
    }
  }
}
